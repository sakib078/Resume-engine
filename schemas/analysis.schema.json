{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["job", "company", "problems", "keywords", "duties"],
  "properties": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "seniority", "spelling"],
      "properties": {
        "title": {"type": "string", "minLength": 2},
        "seniority": {"enum": ["intern", "graduate", "junior", "mid", "senior", "lead", "principal", "manager", "director", "unknown"]},
        "location": {"type": "string"},
        "employment_type": {"type": "string"},
        "years_required": {"type": ["integer", "null"]},
        "spelling": {"enum": ["en-GB", "en-US"]}
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "industry": {"type": "string"},
        "stage": {"type": "string"},
        "size": {"type": "string"},
        "product": {"type": "string"},
        "values": {"type": "array", "items": {"type": "string"}},
        "tech_stack": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "problem", "evidence_in_jd"],
        "properties": {
          "id": {"type": "string", "pattern": "^P[1-5]$"},
          "problem": {"type": "string", "minLength": 1},
          "evidence_in_jd": {"type": "string", "minLength": 1}
        }
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "importance", "category"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "importance": {"enum": ["required", "preferred"]},
          "category": {"enum": ["technical", "tool", "domain", "methodology", "soft_skill", "certification", "other"]},
          "aliases": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "duties": {"type": "array", "maxItems": 10, "items": {"type": "string"}}
  }
}
