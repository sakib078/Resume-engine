{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Master profile",
  "type": "object",
  "required": ["basics", "work", "skills"],
  "properties": {
    "basics": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"},
        "phone": {"type": "string"},
        "location": {"type": "string"},
        "linkedin": {"type": "string"},
        "website": {"type": "string"},
        "github": {"type": "string"}
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "target_roles": {"type": "array", "items": {"type": "string"}},
        "page_limit": {"enum": ["auto", 1, 2]},
        "spelling": {"enum": ["auto", "en-GB", "en-US"]},
        "new_grad": {"type": "boolean"}
      }
    },
    "work": {"type": "array", "items": {"$ref": "#/$defs/role"}},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}},
    "education": {"type": "array", "items": {"$ref": "#/$defs/education"}},
    "certificates": {"type": "array", "items": {"$ref": "#/$defs/certificate"}},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "month": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
    "end": {"type": "string", "pattern": "^(\\d{4}-(0[1-9]|1[0-2])|present)$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result", "how"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "result": {"type": "string", "minLength": 1},
        "how": {"type": "string", "minLength": 1},
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "meaning"],
            "properties": {"value": {"type": "string"}, "meaning": {"type": "string"}}
          }
        },
        "skills": {"type": "array", "items": {"type": "string"}},
        "ai_used": {"type": "boolean"},
        "link": {"type": "string"},
        "raw_notes": {"type": "string"}
      }
    },
    "role": {
      "type": "object",
      "required": ["id", "company", "title", "start", "end", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "company": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "location": {"type": "string"},
        "start": {"$ref": "#/$defs/month"},
        "end": {"$ref": "#/$defs/end"},
        "summary": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "link": {"type": "string"},
        "start": {"$ref": "#/$defs/month"},
        "end": {"$ref": "#/$defs/end"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "education": {
      "type": "object",
      "required": ["institution", "degree"],
      "properties": {
        "institution": {"type": "string"},
        "degree": {"type": "string"},
        "field": {"type": "string"},
        "grade": {"type": "string"},
        "location": {"type": "string"},
        "start": {"$ref": "#/$defs/month"},
        "end": {"$ref": "#/$defs/end"}
      }
    },
    "certificate": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "issuer": {"type": "string"},
        "date": {"$ref": "#/$defs/month"}
      }
    },
    "skill": {
      "type": "object",
      "required": ["name", "category"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
