{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tailored résumé version",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "basics", "tagline", "summary", "summary_evidence_ids", "skills", "work", "education", "changes"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "email": {"type": "string"},
        "phone": {"type": "string"},
        "location": {"type": "string"},
        "linkedin": {"type": "string"},
        "website": {"type": "string"},
        "github": {"type": "string"}
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1}
        }
      }
    },
    "tagline": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "minLength": 1},
    "summary_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "education_first": {"type": "boolean"},
    "skills": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "items"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "items": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string"}}
        }
      }
    },
    "work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role_id", "company", "title", "start", "end", "bullets"],
        "properties": {
          "role_id": {"type": "string"},
          "company": {"type": "string"},
          "title": {"type": "string"},
          "location": {"type": "string"},
          "start": {"$ref": "#/$defs/month"},
          "end": {"$ref": "#/$defs/end"},
          "bullets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bullet"}}
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "name", "bullets"],
        "properties": {
          "project_id": {"type": "string"},
          "name": {"type": "string"},
          "link": {"type": "string"},
          "start": {"$ref": "#/$defs/month"},
          "end": {"$ref": "#/$defs/end"},
          "bullets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bullet"}}
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution", "degree"],
        "properties": {
          "institution": {"type": "string"},
          "degree": {"type": "string"},
          "field": {"type": "string"},
          "grade": {"type": "string"},
          "location": {"type": "string"},
          "start": {"$ref": "#/$defs/month"},
          "end": {"$ref": "#/$defs/end"},
          "coursework": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "issuer": {"type": "string"},
          "date": {"$ref": "#/$defs/month"}
        }
      }
    },
    "achievements": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "items"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "items": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string"}}
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "change", "why"],
        "properties": {
          "section": {"type": "string"},
          "change": {"type": "string"},
          "why": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "month": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
    "end": {"type": "string", "pattern": "^(\\d{4}-(0[1-9]|1[0-2])|present)$"},
    "bullet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
