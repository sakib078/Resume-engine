{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recruiter and copywriter review of one résumé version",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recruiter", "copywriter", "issues"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "recruiter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "shortlist", "comment"],
      "properties": {
        "rating": {"type": "integer", "minimum": 1, "maximum": 5},
        "shortlist": {"type": "boolean"},
        "comment": {"type": "string"}
      }
    },
    "copywriter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "comment"],
      "properties": {
        "rating": {"type": "integer", "minimum": 1, "maximum": 5},
        "comment": {"type": "string"}
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "lens", "where", "issue", "suggestion"],
        "properties": {
          "severity": {"enum": ["major", "minor"]},
          "lens": {"enum": ["recruiter", "copywriter"]},
          "rule": {"type": "string"},
          "where": {"type": "string"},
          "issue": {"type": "string"},
          "suggestion": {"type": "string"}
        }
      }
    }
  }
}
